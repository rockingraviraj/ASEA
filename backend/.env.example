# ASEA Environment Configuration Template
# Copy to .env and configure real credentials. Never commit .env to source control.

SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/asea
DATABASE_USERNAME=asea
DATABASE_PASSWORD=your_secure_db_password_here
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_if_any
REDIS_TIMEOUT=2s

# Production API Security Credentials (REQUIRED on startup in default profile)
API_KEY=your_secure_random_api_key_here
JWT_SECRET=your_minimum_256_bit_secure_jwt_secret_key_here
ASEA_TENANT_ID=primary-tenant

LOG_LEVEL=INFO
